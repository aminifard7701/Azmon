async function shareExam(examId, examTitle) {

    const url =
        window.location.origin +
        "/exam.php?id=" +
        encodeURIComponent(examId);

    if (navigator.share) {

        try {
            await navigator.share({
                title: examTitle,
                text: "برای شرکت در آزمون وارد لینک زیر شوید:",
                url: url
            });

        } catch (error) {
            if (error.name !== "AbortError") {
                console.error(error);
            }
        }

    } else {

        try {
            await navigator.clipboard.writeText(url);

            alert("لینک آزمون کپی شد.");

        } catch (error) {
            alert("امکان کپی خودکار وجود ندارد: " + url);
        }
    }
}
